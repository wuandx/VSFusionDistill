# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# env
.venv/
.venv-gpu/

# experiment outputs
work_dirs/
results/
*.log
# ... except the third-party watch record (route-a evidence)
!doc/logs/*.log

# data (large, re-downloadable; manifests and hashes are committed)
data/

# third_party: clones are reproducible from third_party/PINNED.md
third_party/*
!third_party/PINNED.md
!third_party/README.md

# scratch eval/projection outputs (reproducible from tools/)
work/

# Research snapshots: large/runtime artifacts stay outside Git
**/__pycache__/
*.pth
*.pt
*.onnx
*.7z
*.tar
*.mp4
*.avi
*.pyd
research/**/images/
research/**/previews/
research/**/vis_data/
